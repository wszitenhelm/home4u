generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Listing {
  id                 String            @id @default(cuid())
  source             Marketplace
  sourceListingId    String?
  sourceUrl          String            @db.VarChar(512)
  sourceUrlCanonical String            @db.VarChar(512)
  sourceContentHash  String?           @db.VarChar(191)
  propertyType       PropertyType?
  transactionType    TransactionType?
  publicationStatus  PublicationStatus
  rejectionReason    String?           @db.VarChar(255)
  title              String?           @db.VarChar(512)
  descriptionRaw     String?           @db.LongText
  descriptionClean   String?           @db.LongText
  descriptionSummary String?           @db.LongText
  priceAmount        Decimal?          @db.Decimal(12, 2)
  currency           CurrencyCode?
  administrativeFee  Decimal?          @db.Decimal(12, 2)
  depositAmount      Decimal?          @db.Decimal(12, 2)
  utilitiesDescription String?         @db.VarChar(512)
  areaM2             Decimal?          @db.Decimal(8, 2)
  rooms              Int?
  city               String?           @db.VarChar(191)
  district           String?           @db.VarChar(191)
  street             String?           @db.VarChar(191)
  latitude           Decimal?          @db.Decimal(10, 7)
  longitude          Decimal?          @db.Decimal(10, 7)
  floor              Int?
  floorCount         Int?
  buildingYear       Int?
  marketType         String?           @db.VarChar(191)
  ownershipType      String?           @db.VarChar(191)
  buildingType       String?           @db.VarChar(191)
  heatingType        String?           @db.VarChar(191)
  condition          String?           @db.VarChar(191)
  sellerType         String?           @db.VarChar(191)
  availableFrom      DateTime?
  sourcePublishedAt  DateTime?
  sourceUpdatedAt    DateTime?
  scrapedAt          DateTime?
  contactName        String?           @db.VarChar(191)
  contactPhone       String?           @db.VarChar(64)
  rawAttributes      Json
  rawPayload         Json
  qualityScore       Int?
  completenessScore  Int?
  consistencyScore   Int?
  duplicateGroupId   String?           @db.VarChar(191)
  isPrimary          Boolean           @default(false)
  photos             ListingPhoto[]
  features           ListingFeature[]
  ingestionIssues    IngestionIssue[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([source, sourceUrlCanonical], map: "listings_source_sourceUrlCanonical_key")
  @@unique([source, sourceListingId], map: "listings_source_sourceListingId_key")
  @@index([publicationStatus, isPrimary], map: "listings_publication_isPrimary_idx")
  @@index([transactionType, city, publicationStatus, isPrimary], map: "listings_search_core_idx")
  @@index([priceAmount], map: "listings_priceAmount_idx")
  @@index([areaM2], map: "listings_areaM2_idx")
  @@index([rooms], map: "listings_rooms_idx")
  @@index([createdAt], map: "listings_createdAt_idx")
  @@index([duplicateGroupId], map: "listings_duplicateGroupId_idx")
  @@index([source, sourceListingId], map: "listings_source_identity_idx")
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(512)
  position  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([listingId, url], map: "listing_photos_listingId_url_key")
  @@index([listingId, position], map: "listing_photos_listingId_position_idx")
}

model ListingFeature {
  id           String           @id @default(cuid())
  listingId    String
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  key          ListingFeatureKey
  valueType    FeatureValueType
  booleanValue Boolean?
  numberValue  Decimal?         @db.Decimal(12, 2)
  textValue    String?          @db.VarChar(191)
  rawValue     String?          @db.VarChar(191)
  createdAt    DateTime         @default(now())

  @@unique([listingId, key], map: "listing_features_listingId_key_key")
  @@index([key], map: "listing_features_key_idx")
}

model ImportRun {
  id                  String          @id @default(cuid())
  source              Marketplace
  startedAt           DateTime
  finishedAt          DateTime?
  status              ImportRunStatus
  configuration       Json
  candidatesDiscovered Int           @default(0)
  pagesFetched        Int             @default(0)
  parsedCount         Int             @default(0)
  normalizedCount     Int             @default(0)
  publishedCount      Int             @default(0)
  rejectedCount       Int             @default(0)
  needsReviewCount    Int             @default(0)
  duplicateCount      Int             @default(0)
  failedCount         Int             @default(0)
  issues              IngestionIssue[]
  createdAt           DateTime        @default(now())

  @@index([source, startedAt], map: "import_runs_source_startedAt_idx")
}

model IngestionIssue {
  id         String         @id @default(cuid())
  importRunId String
  importRun  ImportRun      @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sourceUrl  String         @db.VarChar(512)
  stage      IngestionStage
  result     IngestionResult
  code       String         @db.VarChar(191)
  message    String         @db.VarChar(512)
  context    Json
  createdAt  DateTime       @default(now())

  @@index([importRunId, stage], map: "ingestion_issues_importRunId_stage_idx")
  @@index([listingId], map: "ingestion_issues_listingId_idx")
}

enum Marketplace {
  SELECTED_MARKETPLACE
}

enum PropertyType {
  APARTMENT
}

enum CurrencyCode {
  PLN
}

enum TransactionType {
  SALE
  RENT
}

enum PublicationStatus {
  PUBLISHED
  REJECTED
  NEEDS_REVIEW
  DUPLICATE
  EXPIRED
}

enum IngestionStage {
  DISCOVERY
  FETCH
  PARSE
  NORMALIZE
  VALIDATE
  DEDUPLICATE
  PERSIST
}

enum IngestionResult {
  SUCCESS
  FAILED
  REJECTED
  DUPLICATE
}

enum ImportRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum FeatureValueType {
  BOOLEAN
  NUMBER
  TEXT
}

enum ListingFeatureKey {
  BALCONY
  ELEVATOR
  PARKING
  GARAGE
  TERRACE
  GARDEN
  FURNISHED
  PET_FRIENDLY
  AIR_CONDITIONING
  STORAGE_ROOM
  SECURITY
  GATED_PROPERTY
}
