# Next.js runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# MySQL / Prisma
# Default local development database from docker-compose.yml
DATABASE_URL=mysql://home4u:home4u@127.0.0.1:3306/home4u

# Shadow database used only by `prisma migrate dev` in local development.
# The application user above is intentionally scoped to only the `home4u`
# schema, so migrations use the root credentials from docker-compose.yml
# (a disposable local container) to create and drop the temporary shadow
# database. Not required for `prisma migrate deploy` or the running app.
SHADOW_DATABASE_URL=mysql://root:root@127.0.0.1:3306/home4u_shadow

# Ingestion source selection
# The code normalizes this value internally, but keep the canonical form in docs and examples.
INGESTION_SOURCE=selected-marketplace

# Target cities for live ingestion
# Supported values in this MVP: krakow,warszawa,wroclaw,gdansk
INGESTION_CITIES=krakow,warszawa,wroclaw,gdansk

# Publication targets
INGESTION_TARGET_SALE=50
INGESTION_TARGET_RENT=50

# Crawl breadth limits
INGESTION_MAX_CANDIDATES=250
INGESTION_MAX_RESULT_PAGES=10

# Deterministic ordering seed
INGESTION_SEED=real-estate-mvp-v1

# Crawlee concurrency and timeout settings
INGESTION_HTTP_CONCURRENCY=4
INGESTION_BROWSER_CONCURRENCY=1
INGESTION_HTTP_TIMEOUT_MS=15000
INGESTION_BROWSER_TIMEOUT_MS=30000
INGESTION_MAX_REQUEST_ATTEMPTS=3

# Public and descriptive user agent for marketplace requests
INGESTION_USER_AGENT=Home4uMvpCrawler/0.1 (+http://localhost:3000)

# Optional AI listing-summary feature via Gemini (see src/modules/ingestion/ai).
# Leave GEMINI_API_KEY unset to skip it entirely; the app is fully functional without it.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
