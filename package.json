{
  "name": "home4u",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "ingest": "node --env-file=.env --import tsx scripts/ingest.ts",
    "ai:backfill": "node --env-file=.env --import tsx scripts/backfill-ai-summaries.ts",
    "photos:backfill": "node --env-file=.env --import tsx scripts/backfill-listing-photos.ts",
    "locations:backfill": "node --env-file=.env --import tsx scripts/backfill-listing-coordinates.ts",
    "freshness:check": "node --env-file=.env --import tsx scripts/check-freshness.ts",
    "embeddings:backfill": "node --env-file=.env --import tsx scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.1.2",
    "crawlee": "^3.15.1",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "^15.5.22",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
